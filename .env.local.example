# Server-only credentials. Never use NEXT_PUBLIC_ for these variables.
GROQ_API_KEY=
ADMIN_PASSWORD=

# Production: the connection string already supplied by Redis/Vercel.
# Use the provider's exact redis:// or rediss:// URL (rediss enables TLS).
REDIS_URL=

# Optional alternative when REDIS_URL is not configured: a REST pair.
# KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
